# Copy to .env and fill in. app/config.py loads this file via
# pydantic-settings; every variable below maps to a field there.

# NVIDIA NIM API key, used by rag/generation.py for answer generation.
NVIDIA_API_KEY=

# Redis endpoint (Upstash in the deployed setup). Required - it backs both
# the conversation history store (app/session.py) and the embedding /
# retrieval caches (app/cache.py). No default: an unset value should fail
# at startup rather than run with nowhere to persist sessions.
REDIS_URL=

# Qdrant Cloud, which holds the vector collection (Checkpoint 6 replaced
# the local FAISS index with it). URL and API key are required with no
# defaults - the app cannot retrieve anything without them. The collection
# name defaults to "arxiv_agent" and only needs setting to override it.
QDRANT_URL=
QDRANT_API_KEY=
# QDRANT_COLLECTION=arxiv_agent

# Origin of the deployed frontend (the Hugging Face Space), so app/api.py
# can allow cross-origin requests from it. Leave empty to disable CORS
# entirely rather than allowing everything.
CORS_ALLOWED_ORIGIN=
